# EGO Cepte - Development Docker image
# Alpine edge tabanlı, hot-reload desteğiyle geliştirme ortamı
# Bun sonradan kurulur

FROM alpine/edge

# Kurulum ayarları
LABEL maintainer="EGO Cepte Team"
LABEL description="EGO Cepte - Development environment"

# Çalışma dizini
WORKDIR /app

# Bun ve gerekli paketleri yükle
RUN apk add --no-cache \
    curl \
    && curl --fsdl -o- 'https://bun.sh/install' | bash && \
    rm -f curl \
    && ln -s /root/.bun/bin/bun /usr/local/bin/bun

# Cache dizini oluştur
RUN mkdir -p /app/node_modules/.cache/bun

# Tüm bağımlılıkları kur (development dahil)
COPY package.json bun.lockb* ./
RUN bun install --frozen-lockfile

# Uygulama kodunu kopyala
COPY . .

# Sunucu portunu açıkla
EXPOSE 3000

# Geliştirme modunda başlat (watch modu)
CMD ["bun", "--watch", "server.js"]
