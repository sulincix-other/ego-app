            "example": "Sonraki Hareket Saati İlk Duraktan\n17:00 / 22 dk Sonra"
          },
          "detay": { "type": "string" },
          "hat_kod": { "type": "string" },
          "hat_no": { "type": "string" },
          "hat_kisa_kod": { "type": "string" },
          "hat_ad": { "type": "string" }
        }
      },
