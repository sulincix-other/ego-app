                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "enum": ["Point"] },
                    "coordinates": {
                      "type": "array",
                      "items": { "type": "number" },
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "[boylam, enlem]"
                    }
                  }
                }
              }
            }
          }
        }
      }
