                "tur": { "type": "string", "example": "PAZAR" },
                "saat": { "type": "string", "example": "22" },
                "dakika": { "type": "string", "example": "46" },
                "detay": { "type": "string" }
              }
            }
          },
          "message": { "type": "string", "example": "8/9/2026 5:20:28 PM" },
          "status": { "type": "string", "enum": ["TRUE", "FALSE"] }
        }
      },
      "DuyurularResponse": {
        "type": "object",
        "properties": {
          "table": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "example": "h6447" },
                "baslik": { "type": "string" },
                "tarih": { "type": "string", "example": "DUYURU 07.08.2026" }
              }
            }
          }
        }
      },
      "YakinDuraklarResponse": {
        "type": "object",
        "properties": {
          "table": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/components/schemas/Durak" },
                {
                  "type": "object",
                  "properties": {
                    "detay": { "type": "string", "description": "Mesafe (ör. `143 m`)." },
                    "hatlar": { "type": "string", "description": "Virgülle ayrılmış hat kodları.", "example": "351, 364, 387" }
                  }
                }
              ]
            }
          },
          "message": { "type": "string" },
          "status": { "type": "string", "enum": ["TRUE", "FALSE"] }
        }
