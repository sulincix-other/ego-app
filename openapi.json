        "properties": {
          "arac_no": { "type": "string", "example": "11-102" },
          "plaka_no": { "type": "string", "example": "06 DD 9507" },
          "lat": { "type": "string", "example": "39.88089" },
          "lng": { "type": "string", "example": "32.71118833" },
          "hiz": { "type": "string", "example": "0 km" },
          "durak_no": { "type": "string", "description": "Aracın son bildirdiği durak kodu." },
          "onceki_durak_no": { "type": "string" },
          "hat_no": { "type": "string" },
          "hat_kod": { "type": "string" },
          "hat_ad": { "type": "string" },
          "hat_kisa_kod": { "type": "string" },
          "konum_tarihi": { "type": "string", "example": "09.08.2026 16:38:05" },
          "durak_sira_no": { "type": "string" },
          "aci": { "type": "string", "description": "Araç yön açısı." },
          "doluluk": {
            "type": "object",
            "properties": { "message": { "type": "string" } }
          },
          "detay": { "type": "string", "example": "Solo‚ Engelli" },
          "trafik": { "$ref": "#/components/schemas/Trafik" },
          "saniye": { "type": "string", "description": "Varışa kalan saniye. `999999` = geçti." },
          "sure": { "type": "string", "description": "İnsan okunur varış süresi (`2 dk`, `Geldi`, `Geçti`)." },
          "secili_durak_no": { "type": "string", "description": "Sorgulanan durak kodu." },
          "secili_durak_sira_no": { "type": "string" },
          "yon": { "type": "string" },
          "durum": { "type": "string", "description": "`geldi`, `gidiyor`, `gecti` veya boş." },
          "konum": { "type": "string" }
        }
      },
      "OtobusResponse": {
        "type": "object",
        "properties": {
          "table": {
            "type": "array",
            "items": {
              "oneOf": [
                { "$ref": "#/components/schemas/NextDepartureRow" },
                { "$ref": "#/components/schemas/VehicleRow" }
              ]
            }
          },
          "message": { "type": "string" },
          "status": { "type": "string", "enum": ["TRUE", "FALSE"] }
        }
      },
      "GeoFeatureCollection": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["FeatureCollection"] },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["Feature"] },
                "properties": {
                  "type": "object",
                  "properties": {
                    "osm_type": { "type": "string" },
                    "osm_id": { "type": "integer" },
                    "osm_key": { "type": "string" },
                    "osm_value": { "type": "string" },
                    "type": { "type": "string" },
                    "postcode": { "type": "string" },
                    "countrycode": { "type": "string" },
                    "name": { "type": "string" },
                    "city": { "type": "string" },
                    "state": { "type": "string" },
                    "country": { "type": "string" }
                  }
                },
