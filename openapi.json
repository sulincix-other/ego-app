          "label": { "type": "string", "example": "Yoğun" },
          "trafficLevel": { "type": "string", "example": "yogun" },
          "avgDelayMinutes": { "type": "number", "example": 5.0 },
          "avgDelayText": { "type": "string", "example": "5" },
          "reason": { "type": "string", "nullable": true },
          "lastSeenUtc": { "type": "string", "format": "date-time" }
        }
      },
      "VehicleRow": {
        "type": "object",
        "description": "Canlı araç satırı.",
