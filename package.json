    "android:sync": "bunx cap sync android",
    "android:icons": "bunx capacitor-assets generate --android",
    "android:open": "bunx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10"
  },
  "devDependencies": {
    "@capacitor/assets": "3",
    "@capacitor/cli": "7.6.10"
  }
}
