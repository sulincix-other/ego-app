{
  "name": "ego-cepte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EGO Cepte — Ankara otobüs takip uygulaması (Bun tabanlı, web + mobil uyumlu)",
  "scripts": {
    "start": "bun run server.js",
